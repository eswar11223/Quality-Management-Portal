@page "/ForgotPassword"
@model Quality_management_portal.Pages.ForgotPassword.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="forgot-container">

    <div class="forgot-box">

        <h1>Forgot Password</h1>

        <p class="forgot-subtitle">
            Reset your portal password
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="forgot-error">
                @Model.ErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="forgot-success">
                @Model.SuccessMessage
            </div>
        }


        <!-- STEP 1: ENTER USER DETAILS -->
        @if (!Model.OtpSent && !Model.PasswordReset)
        {
            <form method="post" asp-page-handler="SendOtp">

                <div class="form-group">

                    <label asp-for="UsernameOrEmail">
                        Username or Email
                    </label>

                    <input asp-for="UsernameOrEmail"
                           class="form-control"
                           placeholder="Enter username or email" />

                </div>


                <div class="form-group">

                    <label asp-for="MobileNumber">
                        Mobile Number
                    </label>

                    <input asp-for="MobileNumber"
                           class="form-control"
                           placeholder="Enter mobile number" />

                </div>


                <button type="submit" class="forgot-button">
                    Send OTP
                </button>

            </form>
        }


        <!-- STEP 2: VERIFY OTP -->
        @if (Model.OtpSent && !Model.PasswordReset)
        {
            <form method="post" asp-page-handler="VerifyOtp">

                <!-- KEEP USER DETAILS -->
                <input type="hidden"
                       asp-for="UsernameOrEmail" />

                <input type="hidden"
                       asp-for="MobileNumber" />


                <div class="form-group">

                    <label asp-for="Otp">
                        Enter OTP
                    </label>

                    <input asp-for="Otp"
                           class="form-control"
                           placeholder="Enter OTP" />

                </div>


                <p>
                    Demo OTP: <strong>123456</strong>
                </p>


                <button type="submit" class="forgot-button">
                    Verify OTP
                </button>

            </form>
        }


        <!-- STEP 3: RESET PASSWORD -->
        @if (Model.PasswordReset)
        {
            <form method="post" asp-page-handler="ResetPassword">

                <!-- KEEP USER DETAILS -->
                <input type="hidden"
                       asp-for="UsernameOrEmail" />

                <input type="hidden"
                       asp-for="MobileNumber" />


                <div class="form-group">

                    <label asp-for="NewPassword">
                        New Password
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           placeholder="Enter new password" />

                </div>


                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                        Confirm New Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm new password" />

                </div>


                <button type="submit" class="forgot-button">
                    Reset Password
                </button>

            </form>
        }


        <div class="forgot-login-link">

            <a href="/Login">
                Back to Login
            </a>

        </div>

    </div>

</div>