
@page "/MandD/Create"
@model Quality_management_portal.Pages.MandD.Create.CreateModel

@{
    ViewData["Title"] = "Add New Deliverable";
}

<div class="dashboard-layout">
    @await Html.PartialAsync("_DashboardHeader")

    <div class="dashboard-body">
        @await Html.PartialAsync("_Sidebar")

        <main class="dashboard-content">
            <h1 class="dashboard-welcome">Add New Deliverable</h1>

            <form method="post" class="mandd-edit-form">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mandd-form-row">
                    <label asp-for="MilestoneName">Milestone Name</label>
                    <input asp-for="MilestoneName" />
                    <span asp-validation-for="MilestoneName" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="DeliverableName">Deliverable Name</label>
                    <input asp-for="DeliverableName" />
                    <span asp-validation-for="DeliverableName" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="DeliverableType">Deliverable Type</label>
                    <select asp-for="DeliverableType">
                        <option value="">Select Deliverable Type</option>
                        <option>UGs</option>
                        <option>Clarification Doc</option>
                        <option>Data Sheets</option>
                        <option>Other</option>
                    </select>
                    <span asp-validation-for="DeliverableType" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="CustomDeliverableType">Custom Deliverable Type</label>
                    <input asp-for="CustomDeliverableType"
                           placeholder="Enter type when Other is selected" />
                    <span asp-validation-for="CustomDeliverableType" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="MilestoneTargetDate">Milestone Target Date</label>
                    <input asp-for="MilestoneTargetDate" type="text"
                           placeholder="Use the same date format as existing records" />
                    <span asp-validation-for="MilestoneTargetDate" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="DeliverableTargetDate">Deliverable Target Date</label>
                    <input asp-for="DeliverableTargetDate" type="text"
                           placeholder="Use the same date format as existing records" />
                    <span asp-validation-for="DeliverableTargetDate" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="AssignedTo">Assigned To</label>
                    <select asp-for="AssignedTo">
                        <option value="">Select User</option>
                        @foreach (var user in Model.RegisteredUsers)
                        {
                            <option value="@user">@user</option>
                        }
                    </select>
                    <span asp-validation-for="AssignedTo" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="ScheduleDeviation">Any Schedule Deviation</label>
                    <select asp-for="ScheduleDeviation">
                        <option value="">Select</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                    <span asp-validation-for="ScheduleDeviation" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="DeliverableActivity">Deliverable at Which Activity</label>
                    <select asp-for="DeliverableActivity" multiple>
                        <option value="GN">GN</option>
                        <option value="AdHoc">AdHoc</option>
                        <option value="Agile">Agile</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="DeliverableActivity" class="text-danger"></span>
                </div>

                <div class="mandd-form-row" id="deviationReasonContainer" hidden>
                    <label asp-for="ScheduleDeviationReason">Reason for Schedule Deviation</label>
                    <textarea asp-for="ScheduleDeviationReason"></textarea>
                    <span asp-validation-for="ScheduleDeviationReason" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="ActualCompletedDate">Deliverable Actual Completed Date</label>
                    <input asp-for="ActualCompletedDate" type="text"
                           placeholder="DD-MM-YYYY" />
                </div>

                <div class="mandd-form-row">
                    <label asp-for="MilestoneAchievedDate">Milestone Achieved Date</label>
                    <input asp-for="MilestoneAchievedDate" type="text" />
                </div>

                <div class="mandd-form-row">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status">
                        <option value="Not Started">Not Started</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>
                        <option value="Deferred">Deferred</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="mandd-form-row">
                    <label asp-for="Remarks">Remarks</label>
                    <textarea asp-for="Remarks"></textarea>
                </div>

                <div class="mandd-edit-actions">
                    <button type="submit" class="mandd-save-button">
                        Create Deliverable
                    </button>

                    <a href="/MandD" class="mandd-back-button">Cancel</a>
                </div>
            </form>
        </main>
    </div>

    <footer class="dashboard-footer">
        © 2026 i-ray IT Solutions. All rights reserved.
    </footer>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // 1. Automatically manage the completed date
            const statusDropdown = document.getElementById("Status");
            const completedDate = document.getElementById("ActualCompletedDate");

            
            function updateCompletedDate() {
                if (!statusDropdown || !completedDate) return;

                if (statusDropdown.value === "Completed") {
                    if (completedDate.value === "") {
                        const today = new Date();

                        const day = String(today.getDate()).padStart(2, "0");
                        const month = String(today.getMonth() + 1).padStart(2, "0");
                        const year = today.getFullYear();

                        completedDate.value = day + "-" + month + "-" + year;
                    }
                } else {
                    completedDate.value = "";
                }
            }


            if (statusDropdown && completedDate) {
                statusDropdown.addEventListener("change", updateCompletedDate);
                updateCompletedDate();
            }

            // 2. Show the deviation reason only when Yes is selected
            const deviationDropdown = document.getElementById("ScheduleDeviation");
            const reasonContainer = document.getElementById("deviationReasonContainer");
            const reasonField = document.getElementById("ScheduleDeviationReason");

            function updateDeviationReason() {
                if (!deviationDropdown || !reasonContainer) return;

                const showReason = deviationDropdown.value === "Yes";

                reasonContainer.hidden = !showReason;

                if (reasonField) {
                    reasonField.required = showReason;

                    if (!showReason) {
                        reasonField.value = "";
                    }
                }
            }

            if (deviationDropdown && reasonContainer) {
                deviationDropdown.addEventListener("change", updateDeviationReason);
                updateDeviationReason();
            }

        });
    </script>
}
