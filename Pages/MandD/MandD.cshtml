@page "/MandD"
@model Quality_management_portal.Pages.MandD.MandDModel

@{
    ViewData["Title"] = "M & D";
}

<div class="dashboard-layout">

@await Html.PartialAsync("_DashboardHeader")


    <div class="dashboard-body">

        @await Html.PartialAsync("_Sidebar")

        <main class="dashboard-content">

            <h1 class="dashboard-welcome">
                M & D (Milestones & Delivery)
            </h1>

            <p class="dashboard-message">
                M & D module
            </p>

        </main>

    </div>


    <footer class="dashboard-footer">
        © 2026 i-ray IT Solutions. All rights reserved.
    </footer>

</div>


<script>

    function toggleUserMenu() {

        var menu = document.getElementById("userMenu");

        if (menu.style.display === "block") {

            menu.style.display = "none";

        } else {

            menu.style.display = "block";

        }

    }


    document.addEventListener("click", function (event) {

        var menu = document.getElementById("userMenu");

        var button = document.querySelector(".menu-button");

        if (!menu.contains(event.target) &&
            !button.contains(event.target)) {

            menu.style.display = "none";

        }

    });

</script>